#!/bin/sh
# 規則・リファレンス・言い回しの一覧から、Claude Code 以外のエージェントに貼る AGENTS.snippet.md を作る。
# dev/build --check は、AGENTS.snippet.md が本文と食い違っていれば失敗する（書き換えない）。
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
W="$ROOT/skills/writing-rules"
TMP="$(mktemp -d)"
trap 'rm -r -- "$TMP"' EXIT

{
    printf '<!-- wakariyasu:AGENTS.snippet.md -->\n'
    printf '\n# wakariyasu のファイルの場所\n\n'
    printf 'この本文には、規則（writing-to-user.md・writing-documents.md・polishing.md）、リファレンスの styles.md・asking.md、言い回しの一覧（terms.tsv・terms-caution.tsv）が入っている。各ファイルの本文は、ファイル名を書いたコメントの行から始まる。この本文にあるファイルは開き直さなくてよい。本文に入っていないファイルは、wakariyasu のスキルのフォルダにある。\n\n'
    printf -- '- リファレンス（writing-instructions.md・readme.md・changelog.md）: スキル writing-rules のフォルダの references/。読む場面は規則 writing-documents.md にある\n'
    printf -- '- 言い回しの一覧と、ファイルに記述した文書を検査するスクリプト: スキル check-terms のフォルダ\n'
    for r in writing-to-user writing-documents polishing; do
        printf '\n<!-- %s -->\n\n' "$r.md"
        cat "$W/rules/$r.md"
    done
    for f in styles asking; do
        printf '\n<!-- %s -->\n\n' "$f.md"
        cat "$W/references/$f.md"
    done
    printf '\n'
    sh "$ROOT/skills/check-terms/scripts/terms-table"
    printf '\n<!-- /wakariyasu:AGENTS.snippet.md -->\n'
} > "$TMP/AGENTS.snippet.md"

if [ "${1:-}" = "--check" ]; then
    cmp -s "$TMP/AGENTS.snippet.md" "$ROOT/AGENTS.snippet.md" || { echo "食い違い: AGENTS.snippet.md" >&2; exit 1; }
    # 規則・リファレンス・言い回しの一覧と同じ名前のファイルが、ほかのスキルに置かれていないか
    ok=0
    for f in "$ROOT"/skills/*/references/* "$ROOT"/skills/*/rules/* "$ROOT"/skills/*/scripts/*; do
        [ -e "$f" ] || continue
        rel="${f#"$ROOT"/}"
        case "$rel" in skills/writing-rules/* | skills/check-terms/*) continue ;; esac
        name="$(basename "$f")"
        for home in "$W/rules" "$W/references" "$ROOT/skills/check-terms/references" "$ROOT/skills/check-terms/scripts"; do
            [ -e "$home/$name" ] && { echo "本文と同じ名前のファイル: $rel" >&2; ok=1; }
        done
    done
    exit "$ok"
fi
cp "$TMP/AGENTS.snippet.md" "$ROOT/AGENTS.snippet.md"
echo "作った: AGENTS.snippet.md"
