#!/bin/sh
# Check the repository's rules. Calls no model; runs with sh and standard commands only.
# Prints each failed check to standard error, and exits 1 if any check fails.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 1
fail=0
ng() { echo "NG: $*" >&2; fail=1; }

# 1. AGENTS.snippet.md matches the sources, and no other skill holds a file with a source file's name
dev/build --check >/dev/null || ng "AGENTS.snippet.md differs from the sources, or another skill holds a file with a source file's name (see the output of dev/build --check)"

# 2. plugin.json, marketplace.json and CHANGELOG.md have the same version
version_of() { sed -n 's/^ *"version": "\([^"]*\)".*/\1/p' "$1"; }
v_plugin="$(version_of .claude-plugin/plugin.json)"
v_market="$(version_of .claude-plugin/marketplace.json)"
[ -n "$v_plugin" ] || ng "plugin.json has no version"
[ "$v_plugin" = "$v_market" ] || ng "versions differ: plugin.json $v_plugin / marketplace.json $v_market"
grep -q "^## \[$v_plugin\]" CHANGELOG.md || ng "CHANGELOG.md has no section for $v_plugin"

# 3. The marketplace lists wakariyasu only
n="$(grep -c '"source":' .claude-plugin/marketplace.json)"
[ "$n" = 1 ] || ng "marketplace.json lists a plugin other than wakariyasu"

# 4. Each skill has a name equal to its folder name, and a description
for d in skills/*/; do
    s="${d%/}"; name="${s#skills/}"
    head -1 "$s/SKILL.md" | grep -qx -- '---' || ng "$s/SKILL.md does not start with frontmatter"
    grep -qx "name: $name" "$s/SKILL.md" || ng "the name in $s/SKILL.md differs from the folder name $name"
    grep -q '^description: .' "$s/SKILL.md" || ng "$s/SKILL.md has no description"
done

# 5. The hook prints the rules and asking.md, and gives only the location of each language pack and how to choose one, not the content of the packs
# Claude Code shows a hook command's output inline only up to 10,000 characters, so each command of hooks.json stays under 9,500.
out=""
n_hooks=0
while IFS= read -r cmd; do
    n_hooks=$((n_hooks + 1))
    part="$(CLAUDE_PLUGIN_ROOT="$ROOT" sh -c "$(printf '%s' "$cmd" | sed "s|\${CLAUDE_PLUGIN_ROOT}|$ROOT|g")")" || ng "a hook command failed: $cmd"
    size="$(printf '%s' "$part" | wc -m | tr -d ' ')"
    [ "$size" -le 9500 ] || ng "the output of a hook command is $size characters, over 9500 (Claude Code shows only a preview above 10000): $cmd"
    out="$out
$part"
done <<HOOKS
$(sed -n 's/^ *"command": "\(.*\)"$/\1/p' hooks/hooks.json | sed 's/\\"/"/g')
HOOKS
[ "$n_hooks" -ge 2 ] || ng "hooks/hooks.json has fewer than 2 hook commands (the rules must be split across commands)"
for r in writing-to-user writing-documents polishing; do
    printf '%s\n' "$out" | grep -qxF "$(head -1 "skills/writing-rules/rules/$r.md")" || ng "the hook output lacks skills/writing-rules/rules/$r.md"
done
printf '%s\n' "$out" | grep -qxF "$(head -1 skills/writing-rules/references/asking.md)" || ng "the hook output lacks skills/writing-rules/references/asking.md"
for f in readme writing-instructions changelog; do
    [ -e "skills/writing-rules/references/$f.md" ] || ng "skills/writing-rules/references/$f.md, whose location the hook gives, is missing"
done
printf '%s\n' "$out" | grep -q "$ROOT/skills/writing-rules/references/" || ng "the hook output lacks the location of the references"
printf '%s\n' "$out" | grep -q 'not by the language of the conversation' || ng "the hook output does not say that a pack is chosen by the language of what is written"
printf '%s\n' "$out" | grep -q '^## Fixed words$' || ng "the hook output lacks the Fixed words section"
printf '%s\n' "$out" | sed -n '/^# wakariyasu: file locations/,$p' | grep -q '|---|' && ng "the index of the hook output holds a table (labels reach the agent only through templates and tools)"
for d in skills/writing-rules/lang/*/; do
    code="$(basename "$d")"
    printf '%s\n' "$out" | grep -q "^- $code: $ROOT/${d%/}/ (" || ng "the hook output lacks the location of language pack $code"
    for f in "$d"*.md; do
        printf '%s\n' "$out" | grep -qxF "$(head -1 "$f")" && ng "the hook output contains the content of a language pack ($f)"
    done
done

# 5b. Each language pack file has one of the fixed names. labels.json and the templates are for tools and for printing, so no skill tells the agent to look words up in them.
for f in skills/writing-rules/lang/*/*; do
    case "$(basename "$f")" in
        reply.md | documents.md | skills.md | labels.json | asking-template.md) ;;
        *) ng "a language pack has a file without a fixed name: $f" ;;
    esac
done
for f in skills/session-status/lang/*/* skills/show-changes/lang/*/*; do
    case "$(basename "$f")" in
        labels.json) ;;
        reply-template.md) case "$f" in skills/session-status/*) ;; *) ng "only session-status has reply-template.md: $f" ;; esac ;;
        *) ng "a skill's lang folder has a file without a fixed name: $f" ;;
    esac
done
for d in skills/writing-rules/lang/*/ skills/session-status/lang/*/ skills/show-changes/lang/*/; do
    [ -e "${d}labels.json" ] || ng "$d has no labels.json"
done

# 5c. Words for tools are in labels.json only. Nothing the agent reads sends it to a template or a markdown table for them.
grep -rnE 'conventions\.md|pack_labels|DEFAULT_LABELS|__LABELS__' skills/*/SKILL.md skills/*/references skills/writing-rules/rules skills/writing-rules/lang/*/*.md hooks README.md README.ja.md >&2 &&
    ng "an agent-read file or a README mentions the old label lookup (conventions.md, pack_labels, DEFAULT_LABELS, __LABELS__)"
# labels.py is the same file in every skill that has it
cmp -s skills/session-status/scripts/labels.py skills/show-changes/scripts/labels.py && cmp -s skills/session-status/scripts/labels.py skills/writing-rules/scripts/labels.py ||
    ng "labels.py differs between session-status, show-changes and writing-rules (it must be the same file)"
# The words of a decision question are the same in writing-rules and in session-status, and asking.md shows the English ones
for d in skills/writing-rules/lang/*/; do
    code="$(basename "$d")"
    for k in colOption colOptionDetail recommended; do
        a="$(grep "\"$k\":" "$d/labels.json" | sed 's/,$//')"; b="$(grep "\"$k\":" "skills/session-status/lang/$code/labels.json" 2>/dev/null | sed 's/,$//')"
        [ "$a" = "$b" ] || ng "[$code] $k differs between writing-rules and session-status labels.json"
    done
done
en_opt="$(sed -n 's/.*"colOption": "\(.*\)",$/\1/p' skills/writing-rules/lang/en/labels.json)"
en_detail="$(sed -n 's/.*"colOptionDetail": "\(.*\)",$/\1/p' skills/writing-rules/lang/en/labels.json)"
grep -qF "| $en_opt | $en_detail |" skills/writing-rules/references/asking.md || ng "the table of asking.md does not use the English words of labels.json"
python3 -B dev/test-session-status.py >/dev/null || ng "dev/test-session-status.py failed (run it to see which check)"

# 6. When a rule, reference, language pack or skill names a section of a rule or reference, the named heading exists there.
# English text names it as the "<heading>" section of `x.md`; Japanese text as `x.md`）の「<heading>」の節
srcs="skills/writing-rules/rules/*.md skills/writing-rules/references/*.md skills/writing-rules/lang/*/*.md skills/*/SKILL.md skills/*/references/*.md"
{
    grep -ho '`[a-z-]*\.md`）の「[^」]*」の節' $srcs | sed 's/^`\([^`]*\)`）の「\(.*\)」の節$/\1|\2/'
    grep -ho 'the "[^"]*" section of `[a-z-]*\.md`' $srcs | sed 's/^the "\(.*\)" section of `\([^`]*\)`$/\2|\1/'
} | sort -u | while IFS='|' read -r f h; do
    t=skills/writing-rules/rules/$f; [ -e "$t" ] || t=skills/writing-rules/references/$f
    [ -e "$t" ] || { echo "NG: $f is in neither rules/ nor references/ of skills/writing-rules" >&2; exit 1; }
    grep -qxF "## $h" "$t" || grep -qxF "# $h" "$t" || grep -qxF "### $h" "$t" || { echo "NG: $t has no heading \"$h\"" >&2; exit 1; }
done || fail=1

# 7. The files in the repository that README.md and README.ja.md link to exist
for readme in README.md README.ja.md; do grep -o '](\([^)#:]*\))' "$readme" | sed 's/^](//; s/)$//'; done | while read -r p; do
    [ -e "$p" ] || { echo "NG: $p, linked from a README, is missing" >&2; exit 1; }
done || fail=1

# 8. The .editorconfig settings (git handles UTF-8; this checks line endings and whitespace)
git ls-files | while read -r f; do
    [ -s "$f" ] || continue
    [ -z "$(tail -c1 "$f")" ] || echo "NG: no newline at end of file: $f" >&2
    if grep -q "$(printf '\r')" "$f"; then echo "NG: contains CR: $f" >&2; fi
    case "$f" in
        *.tsv) ;;
        *) if grep -q "$(printf '\t')" "$f"; then echo "NG: contains a tab: $f" >&2; fi ;;
    esac
    case "$f" in
        *.md) ;;
        *) if grep -q '[[:blank:]]$' "$f"; then echo "NG: trailing whitespace: $f" >&2; fi ;;
    esac
done 2>&1 | grep . >&2 && fail=1

# 9. Phrase checks, per language. For each language with phrase lists in skills/check-terms/lang/<code>/,
# the cases in tests/lang/<code>/ must give the expected results.
T=skills/check-terms/scripts/check-terms
for d in skills/check-terms/lang/*/; do
    code="$(basename "$d")"
    cases="tests/lang/$code"
    [ -d "$cases" ] || { ng "no test cases for the phrase lists of $code (expected $cases/)"; continue; }

    # 9a. terms-cases.txt: "deny" lines are reported and exit 1; "allow" lines are not reported.
    if [ -e "$d/terms.tsv" ]; then
        [ -e "$cases/terms-cases.txt" ] || ng "missing $cases/terms-cases.txt"
        grep -v '^#' "$cases/terms-cases.txt" | while IFS= read -r l; do
            want=${l%% *}; body=${l#* }
            if printf '%s\n' "$body" | sh "$T" --lang "$code" --no-caution >/dev/null; then got=allow; else got=deny; fi
            [ "$want" = "$got" ] || { echo "NG: [$code] terms check gave $got, expected $want: $body" >&2; exit 1; }
        done || fail=1
    fi

    # 9b. caution-cases.txt: "flag" lines are reported with "(check in context)"; "allow" lines are not. The exit code stays 0.
    if [ -e "$d/terms-caution.tsv" ]; then
        [ -e "$cases/caution-cases.txt" ] || ng "missing $cases/caution-cases.txt"
        grep -v '^#' "$cases/caution-cases.txt" | while IFS= read -r l; do
            want=${l%% *}; body=${l#* }
            if printf '%s\n' "$body" | sh "$T" --lang "$code" | grep -c ' (check in context)$' >/dev/null; then got=flag; else got=allow; fi
            [ "$want" = "$got" ] || { echo "NG: [$code] caution check gave $got, expected $want: $body" >&2; exit 1; }
            printf '%s\n' "$body" | sh "$T" --lang "$code" >/dev/null ||
                { echo "NG: [$code] exit code is not 0 for a line with only phrases to check in context: $body" >&2; exit 1; }
        done || fail=1
    fi

    # 9c. The patterns use no ranges of non-ASCII characters (GNU sed and grep under C.UTF-8 reject them),
    # and running the checker over every case prints no error.
    LC_ALL=C grep -nE '\[[^]]*([^ -~]-|-[^ -~])[^]]*\]' "$d"*.tsv >&2 &&
        ng "[$code] a phrase list has a range of non-ASCII characters (spell the characters out)"
    err=$(cat "$cases"/*-cases.txt | grep -v '^#' | sed 's/^[^ ]* //' | sh "$T" --lang "$code" 2>&1 >/dev/null)
    [ -z "$err" ] || ng "[$code] the phrase check printed an error: $err"

    # 9d. The language pack of the same language uses no phrase to avoid.
    if [ -d "skills/writing-rules/lang/$code" ]; then
        sh "$T" --lang "$code" --no-caution "skills/writing-rules/lang/$code"/*.md >&2 ||
            ng "[$code] the language pack uses a phrase to avoid (fix the lines above)"
    fi
done

# 10. The Japanese README uses no phrase to avoid.
# CHANGELOG.ja.md records past versions, so it is not checked.
for f in README.ja.md; do
    sh "$T" --lang ja --no-caution "$f" >&2 || ng "$f uses a phrase to avoid in Japanese (fix the lines above)"
done

# 11. No bin/ at the top level (claude.ai and Cowork reject a plugin that has one)
[ ! -e bin ] || ng "bin/ exists at the top level (the plugin cannot be installed in claude.ai and Cowork)"

# 12. The bodies of the rules, skills and hooks are in English; text for one language lives in lang/.
# UTF-8 kana start with \343 and \201-\203; kanji start with \344-\351. CJK punctuation is allowed (scripts match it).
kana_kanji="$(printf '\343[\201-\203]|[\344-\351]')"
found="$(LC_ALL=C grep -rlE "$kana_kanji" skills hooks AGENTS.snippet.md | grep -v '/lang/')"
[ -z "$found" ] || ng "Japanese text outside a lang/ folder: $found"

[ "$fail" = 0 ] && echo "all checks passed"
exit "$fail"
