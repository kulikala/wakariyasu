#!/bin/sh
# Print the phrase lists of one language as Markdown tables, for dev/build.
# Usage: terms-table CODE
# Each list (lang/CODE/terms.tsv, then lang/CODE/terms-caution.tsv) becomes a section. The heading, the lead text and
# the column names come from the list's "#title:", "#intro:" and "#columns:" lines; the rows are the first two columns.
set -eu

DIR=$(cd "$(dirname "$0")/.." && pwd)
[ $# -eq 1 ] || { echo "usage: terms-table CODE" >&2; exit 2; }
first=1
for list in "$DIR/lang/$1/terms.tsv" "$DIR/lang/$1/terms-caution.tsv"; do
    [ -e "$list" ] || continue
    [ "$first" = 1 ] || printf '\n'
    first=0
    awk -F '\t' '
        /^#title: / { title = substr($0, 9); next }
        /^#intro: / { intro = substr($0, 9); next }
        /^#columns: / { split(substr($0, 11), c, "|"); next }
        /^#/ || NF < 2 { next }
        !head { printf "# %s\n\n%s\n\n| %s | %s |\n|---|---|\n", title, intro, c[1], c[2]; head = 1 }
        { printf "| %s | %s |\n", $1, $2 }
    ' "$list"
done
