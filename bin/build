#!/bin/sh
# rules/ と references/ の本文から、スキルごとの写しと AGENTS.snippet.md を作る。
# 本文は rules/ と references/ だけで書き換える。
#   skills/<名>/references/*.md … スキルだけを入れた環境で、スキルが読む写し
#   AGENTS.snippet.md          … Claude Code 以外の道具に貼る規則の本文
# bin/build --check は、写しが本文と食い違っていれば失敗する（書き換えない）。
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -r -- "$TMP"' EXIT

# スキル名 と、そのスキルに写す本文（rules/ か references/ からの相対パス）
COPIES='
session-status rules/writing-to-user.md
session-status rules/polishing.md
explain-clearly rules/writing-to-user.md
explain-clearly rules/polishing.md
explain-clearly references/styles.md
remove-meta-narrative rules/writing-documents.md
review-for-readers rules/writing-documents.md
review-for-readers rules/polishing.md
review-for-readers references/styles.md
'
RULES='writing-to-user writing-documents polishing session-status'

{
    printf '<!-- wakariyasu: https://github.com/kulikala/wakariyasu -->\n'
    printf '<!-- rules/ から bin/build で作った写し。ここを直さず、rules/ を直す。 -->\n'
    for r in $RULES; do
        printf '\n'
        cat "$ROOT/rules/$r.md"
    done
} > "$TMP/AGENTS.snippet.md"

ok=0
check() { # $1 作った写し, $2 リポジトリの中の置き場所
    if [ "$MODE" = check ]; then
        cmp -s "$1" "$ROOT/$2" || { echo "食い違い: $2" >&2; ok=1; }
    else
        mkdir -p "$(dirname "$ROOT/$2")"
        cp "$1" "$ROOT/$2"
        echo "写した: $2"
    fi
}
MODE=write
[ "${1:-}" = "--check" ] && MODE=check

printf '%s\n' "$COPIES" > "$TMP/copies"
while read -r skill src; do
    [ -n "$skill" ] || continue
    dest="skills/$skill/references/$(basename "$src")"
    printf '%s\n' "$dest" >> "$TMP/list"
    check "$ROOT/$src" "$dest"
done < "$TMP/copies"
check "$TMP/AGENTS.snippet.md" AGENTS.snippet.md

if [ "$MODE" = check ]; then
    # 写しの一覧に無いファイルが references/ に残っていないか
    for f in "$ROOT"/skills/*/references/*.md; do
        rel="${f#"$ROOT"/}"
        grep -qxF "$rel" "$TMP/list" || { echo "一覧に無い写し: $rel" >&2; ok=1; }
    done
    [ "$ok" = 0 ] && echo "写しは本文と一致している"
fi
exit "$ok"
