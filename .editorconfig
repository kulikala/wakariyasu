root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so keep them
trim_trailing_whitespace = false

[{dev/*,*.sh}]
indent_size = 4

[*.tsv]
# Columns are separated by tabs
indent_style = tab
